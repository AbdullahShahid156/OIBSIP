# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/pizzacraft

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-16-chars
JWT_EXPIRE=7d

# Frontend URL (CORS origin)
CLIENT_URL=http://localhost:3000

# Email Configuration (optional - configure for production)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@pizzacraft.com
FROM_NAME=PizzaCraft

# Socket.io CORS URL
SOCKET_CORS_URL=http://localhost:3000

# Razorpay TEST MODE (no real money)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
